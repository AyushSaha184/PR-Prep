# PR Prep Configuration Environment Template

# Environment & Application Mode
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database Configuration (Tiger Cloud / Postgres)
# Development local fallback or Tiger Cloud production SSL connection string
TIGER_DATABASE_URL=postgresql+asyncpg://pr_prep:pr_prep_password@localhost:5432/pr_prep_dev

# Queue & Cache Configuration (Redis + ARQ)
REDIS_URL=redis://localhost:6379/0

# GitHub App Integration Credentials
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=development_webhook_secret_change_me
GITHUB_PRIVATE_KEY_PATH=/path/to/github-app-private-key.pem

# AI Provider Configuration
OPENAI_API_KEY=sk-placeholder-key-for-development
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=256
DEFAULT_REASONING_MODEL=gpt-4o

# Budget & Economics Controls
DAILY_BUDGET_CAP_USD=50.00
BUDGET_GUARD_ENABLED=true

# Human-in-the-Loop Thresholds
CONFIDENCE_THRESHOLD_AUTO_POST=0.85
MANDATORY_ESCALATION_SEVERITY=CRITICAL
